generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReasonReport {
  FRAUD
  FAKE_INFORMATION
  DUPLICATE
  INAPPROPRIATE_CONTENT
  OTHER
}

enum StatusReport {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

model JobReport {
  jobReportId String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  jobId       String       @db.Uuid
  reason      ReasonReport
  description String?      @db.Text
  status      StatusReport @default(PENDING)
  reportedAt  DateTime     @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("job_reports")
}
