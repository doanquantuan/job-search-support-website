generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobSeekingStatus {
  LOOKING
  OPEN_TO_OFFER
  NOT_LOOKING
}

enum CVType {
  UPLOADED
  BUILT
}

model JobSeeker {
  userId           String           @id @db.Uuid
  jobSeekingStatus JobSeekingStatus @default(OPEN_TO_OFFER)
  
  profile          Profile?
  cvs              CV[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("job_seekers")
}

model Recruiter {
  userId      String   @id @db.Uuid
  position    String?
  isVerified  Boolean  @default(false)
  companyId   String?  @db.Uuid

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("recruiters")
}

model Admin {
  userId    String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Profile {
  userId      String    @id @db.Uuid
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?
  githubUrl   String?

  jobSeeker   JobSeeker @relation(fields: [userId], references: [userId], onDelete: Cascade)
  
  educations         Education[]
  experiences        Experience[]
  projects           Project[]
  awards             Award[]
  certificates       Certificate[]
  careerPreferences  CareerPreference[]
  skills             ProfileSkill[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("profiles")
}

model Education {
  educationId String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  institution String
  major       String
  startDate   DateTime
  endDate     DateTime?
  description String?

  profile     Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("educations")
}

model Experience {
  experienceId String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  companyName  String
  position     String
  startDate    DateTime
  endDate      DateTime?
  description  String?

  profile      Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("experiences")
}

model Project {
  projectId   String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  projectName String
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?

  profile     Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("projects")
}

model Award {
  awardId     String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  awardName   String
  issuer      String?
  awardDate   DateTime?
  description String?

  profile     Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("awards")
}

model Certificate {
  certificateId   String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  certificateName String
  issuer          String
  issueDate       DateTime
  expiryDate      DateTime?
  description     String?

  profile         Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("certificates")
}

model CareerPreference {
  careerPreferenceId String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  expectedSalaryMin  Decimal? @db.Decimal(12, 2)
  expectedSalaryMax  Decimal? @db.Decimal(12, 2)
  preferredLocation  String?
  careerGoal         String?

  profile            Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("career_preferences")
}

model Skill {
  skillId   String         @id @default(uuid()) @db.Uuid
  skillName String         @unique
  userId    String?        @db.Uuid

  profiles  ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  userId  String  @db.Uuid
  skillId String  @db.Uuid

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [skillId], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("profile_skills")
}

model CVTemplate {
  templateId   String  @id @default(uuid()) @db.Uuid
  templateName String
  layout       Json?
  previewUrl   String?

  cvs          CV[]

  @@map("cv_templates")
}

model CV {
  cvId       String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  templateId String?     @db.Uuid
  title      String
  type       CVType      @default(UPLOADED)
  content    Json?
  fileUrl    String?

  jobSeeker  JobSeeker   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  template   CVTemplate? @relation(fields: [templateId], references: [templateId], onDelete: SetNull)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("cvs")
}
