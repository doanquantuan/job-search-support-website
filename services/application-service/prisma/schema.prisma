generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  REVIEWING
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

model Application {
  applicationId     String                     @id @default(uuid()) @db.Uuid
  userId            String                     @db.Uuid
  jobId             String                     @db.Uuid
  cvId              String                     @db.Uuid
  coverLetter       String?                    @db.Text
  applicationStatus ApplicationStatus          @default(APPLIED)
  appliedAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  statusHistories   ApplicationStatusHistory[]

  @@map("applications")
}

model ApplicationStatusHistory {
  historyId         String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  applicationStatus ApplicationStatus
  changedAt         DateTime          @default(now())
  changedBy         String            @db.Uuid
  note              String?           @db.Text

  application       Application       @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)

  @@map("application_status_histories")
}
