PORT=5004
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_search_application?schema=public"

# JWT Secret (Phải trùng khớp với auth-service để xác thực Access Token)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Cors
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

