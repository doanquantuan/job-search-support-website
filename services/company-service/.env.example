PORT=5003
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_search_company?schema=public"

# JWT Secret
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production

# Cors
CORS_ORIGIN=http://localhost:3000

# Cloudflare R2 Credentials
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# 1. Bucket Public (Logo, Environment Photos)
CLOUDFLARE_R2_PUBLIC_BUCKET=job-search-public
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev   # hoặc custom domain: https://cdn.yourdomain.com

# 2. Bucket Private (Business Licenses)
CLOUDFLARE_R2_PRIVATE_BUCKET=job-search-private
CLOUDFLARE_R2_PRESIGNED_EXPIRES_IN=600               # Thời hạn presigned URL (giây, mặc định 10 phút)
