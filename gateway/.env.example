PORT=5000
NODE_ENV=development

# Arcjet Key (đăng ký miễn phí tại https://app.arcjet.com)
# Để trống hoặc điền key của bạn. Nếu không có key, Gateway vẫn chạy ở fallback mode
ARCJET_KEY=
ARCJET_ENV=development

# Frontend Client URL
CLIENT_URL=http://localhost:3000

# Target Microservices URLs
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
COMPANY_SERVICE_URL=http://localhost:5003
APPLICATION_SERVICE_URL=http://localhost:5003

